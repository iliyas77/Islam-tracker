{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "nur-prayer-app",
  "name": "Nur Prayer — Prayer Tracker, Tasbeeh & Duas",
  "short_name": "Nur Prayer",
  "description": "Modern Islamic prayer tracker, Qaza missed prayer calculation, digital tasbeeh with monthly calendar clearance, and Quranic Duas with Telugu transliteration.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#FFFFFF",
  "theme_color": "#123D2E",
  "lang": "en",
  "dir": "ltr",
  "categories": ["lifestyle", "productivity", "utilities"],
  "icons": [
    {
      "src": "icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Prayer Tracker",
      "short_name": "Tracker",
      "description": "Track daily prayers and missed prayers",
      "url": "./#/tracker/current",
      "icons": [{ "src": "icons/icon-192.svg", "sizes": "192x192" }]
    },
    {
      "name": "Digital Tasbeeh",
      "short_name": "Tasbeeh",
      "description": "Chant daily Dhikr and track monthly calendar",
      "url": "./#/tasbeeh/home",
      "icons": [{ "src": "icons/icon-192.svg", "sizes": "192x192" }]
    },
    {
      "name": "Quran Duas",
      "short_name": "Duas",
      "description": "Read and listen to Quranic supplications with Telugu translation",
      "url": "./#/duas/all",
      "icons": [{ "src": "icons/icon-192.svg", "sizes": "192x192" }]
    }
  ]
}

